{
  "name": "zippy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Roadside breakdown dispatch optimised for time-to-resolution, not time-to-arrival.",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "sim": "tsx src/sim/cli.ts",
    "eval": "tsx evaluation/cli.ts",
    "eval:sweep": "tsx evaluation/cli.ts --sweep",
    "eval:scenario": "tsx evaluation/cli.ts --scenario",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "lint": "eslint src evaluation",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@bull-board/api": "^9.5.0",
    "@bull-board/express": "^9.5.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^6.3.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
