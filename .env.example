# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Placeholders only in this file.

NODE_ENV=development
PORT=3000

# Postgres is the source of truth. Matches docker-compose.yml — host port 5433
# (5432 is taken by a native PostgreSQL install on the current dev machine).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/zippy?schema=public

# Redis is cache and queues only.
REDIS_URL=redis://localhost:6379

# Localhost today; a config change at deploy, not a code change.
PUBLIC_URL=http://localhost:3000
WS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Auth. Two different long random strings — never reuse one for both.
# TTLs use the `ms` vocabulary jsonwebtoken understands: 15m, 1h, 7d.
JWT_ACCESS_SECRET=replace-with-32-plus-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# The intake language model (Phase 16). OPTIONAL, and the system is fully
# functional without it: with no key the driver answers the structured symptom
# picker, GET /health reports the extractor DEGRADED, and dispatch is
# unaffected. NEVER PUT A REAL KEY IN THIS FILE — it is committed. Real values
# go in .env, which is gitignored.
#
# LLM_PROVIDER picks the wire protocol, not the vendor's marketing name:
#   anthropic          Messages API, output_config.format   (sk-ant-... keys)
#   openai-compatible  POST /chat/completions               (Groq, and others)
# It is declared rather than guessed from the key's prefix, so rotating a
# credential can never silently change which protocol is spoken.
LLM_API_KEY=replace-me
LLM_PROVIDER=anthropic
# Only read when LLM_PROVIDER=openai-compatible. Groq's endpoint is the default.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Must match the provider: claude-opus-5 for anthropic, or e.g.
# openai/gpt-oss-120b on Groq.
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_MS=8000

# RAZORPAY (Phase 22b) — TEST MODE ONLY. PLACEHOLDERS; real keys go in .env,
# which is gitignored, and never in this file.
#
# All three are OPTIONAL and the system is fully functional without them: with
# no keys the stub provider from Phase 15c stays installed, every settlement
# rule still runs in `npm run test:fast`, the driver's checkout reports itself
# unavailable, and dispatch is unaffected either way.
#
# A LIVE KEY IS REFUSED AT STARTUP. src/infra/config.ts requires the rzp_test_
# prefix, so this project cannot be pointed at real money by a .env edit alone.
#
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET  Dashboard -> Settings -> API Keys.
#   The key id is publishable and reaches the browser; the secret never leaves
#   the server and signs the checkout handshake.
# RAZORPAY_WEBHOOK_SECRET  A DIFFERENT secret, set when you create the webhook
#   endpoint in the dashboard. It signs the webhook body and nothing else.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_MS=8000

# RazorpayX (payouts) is a separate product with its own source account. Without
# it the payout executor reports itself unconfigured and every payout stays
# PENDING rather than guessing at an account.
RAZORPAY_PAYOUT_ACCOUNT_NUMBER=

# How long a payment may sit in a non-terminal state before the reconciliation
# worker asks the gateway what really happened.
RECONCILIATION_STALE_AFTER_MINUTES=10

# THE RESERVATION'S TWO CLOCKS (Phases 11-12), both optional.
#
# OFFER_TTL_MS is how long a technician's phone counts down before the offer
# expires. HOLD_TTL_MS is how long the van stays held while that happens.
# Commented out means the shipped defaults: 45000 and 120000.
#
# THEY ARE COUPLED AND VALIDATED AT STARTUP. The hold must outlive the offer by
# at least 15 seconds, so the accept has time to land before the van is swept
# back onto the board. Raise the offer alone and the process refuses to start
# with a message naming both numbers — an offer that outlives its hold means a
# technician accepts a job whose van has already been released.
#
# A LONGER PAIR FOR A LIVE DEMO, where somebody is talking through the screen
# rather than working. Three minutes to answer, five minutes of hold:
#   OFFER_TTL_MS=180000
#   HOLD_TTL_MS=300000
# OFFER_TTL_MS=45000
# HOLD_TTL_MS=120000

# THE DEPLOYED DEMO BOARD (optional). 'true' makes the web process run
# ensureDemoBoard after migrations on every boot, and the worker keep the four
# demo crews on shift and their stock counted every fifteen minutes. Leave it
# unset locally: the main seed and the test suites never want it.
# DEMO_MODE=true

# WHERE TRAVEL TIMES COME FROM (optional): OSRM or HAVERSINE. Unset means
# HAVERSINE in production (the deployment runs no OSRM service) and OSRM
# everywhere else. /health reports which one is running.
# ROUTING_MODE=OSRM
